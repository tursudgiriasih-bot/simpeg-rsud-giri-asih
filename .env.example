# Salin file ini jadi ".env" untuk development lokal, lalu isi nilainya.
# JANGAN commit file ".env" (sudah masuk .gitignore).
# Untuk deploy di Netlify, isi nilai yang sama di:
# Netlify Dashboard -> Site configuration -> Environment variables

# --- Firebase (client-side, aman untuk di-expose ke browser) ---
# Ambil dari: Firebase Console -> Project Settings -> General ->
# Your apps -> SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Cloudinary (client-side, untuk upload foto/dokumen) ---
# Daftar gratis di cloudinary.com, lalu:
# 1. Catat "Cloud name" dari Dashboard
# 2. Settings -> Upload -> Upload presets -> Add upload preset
#    Signing Mode = "Unsigned", lalu catat nama presetnya
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ============================================================
# Variabel di bawah ini HANYA untuk Netlify Function (server-side).
# JANGAN pernah tambahkan prefix VITE_ pada variabel ini -- kalau
# pakai prefix VITE_, nilainya akan ikut ter-bundle ke kode browser
# dan jadi bisa dibaca siapa saja. Isi HANYA di Netlify Dashboard,
# tidak perlu (dan sebaiknya tidak) ada di .env lokal.
# Diambil dari scripts/serviceAccountKey.json milik Anda sendiri.
# ============================================================
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
